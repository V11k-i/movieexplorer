<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="movie_explorer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:movie_explorer"
    Title="Movie Explorer"
   >
    

        <TabBar>
            <ShellContent
            x:Name="Favs"
            Title="Favourites"
            Route="Favourites"/>

            <ShellContent
            x:Name="Home"
            Title="Home"
            Route="MainPage"/>

            <ShellContent
            x:Name="Settings"
            Title="Settings"
            Route="Settings"/>
        </TabBar>
  
</Shell>
    
    