<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="movie_explorer.MainPage"
              Shell.NavBarIsVisible="False"
               xmlns:controls="clr-namespace:Xaminals.Controls">
    
    <VerticalStackLayout>
        <SearchBar>

        </SearchBar>
        <Grid>
            <CollectionView ItemsSource="{Binding Movies}"
                            SelectedItem="{Binding SelectedMovie}"
                            SelectionChanged="CollectionView_SelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Movie">
                        <StackLayout Padding="10">
                            <Label Text="{Binding Title}" FontSize="Medium" FontAttributes="Bold"/>
                            <Label Text="{Binding Rating}" FontSize="Small"/>
                            <Label Text="{Binding Year}" FontSize="Small"/>
                            <Label Text="{Binding Genre}" FontSize="Small"/>
                            <Label Text="{Binding Emoji}" FontSize="Small"/>
                            <Label Text="{Binding Director}" FontSize="Small"/>
                        </StackLayout>

            </CollectionView>
        </Grid>
       
    </VerticalStackLayout>
   
    



</ContentPage>

    
